{
  "name": "issue-intake-smart-summary-system",
  "version": "1.0.0",
  "description": "A Laravel 12 API for a support / operations team to triage incoming tickets. New issues get an auto-generated summary and a suggested next action. Works without an LLM key (rules-based fallback), gets smarter when one's plugged in (Claude, GPT, Gemini, or Perplexity).",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
